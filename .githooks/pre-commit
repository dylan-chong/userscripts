#!/bin/bash

set -e

cd "$(git rev-parse --show-toplevel)"
node builder/build.js
git add build/all.user.js

failed=0

for file in $(git diff --cached --name-only --diff-filter=M | grep '\.user\.js$'); do
    old_version=$(git show HEAD:"$file" 2>/dev/null | grep -m1 '@version' | sed 's/.*@version[[:space:]]*//')
    new_version=$(git show :"$file" | grep -m1 '@version' | sed 's/.*@version[[:space:]]*//')

    if [ -z "$old_version" ]; then
        continue
    fi

    # Check if anything besides the version line actually changed
    old_content=$(git show HEAD:"$file" 2>/dev/null | grep -v '@version')
    new_content=$(git show :"$file" | grep -v '@version')
    if [ "$old_content" = "$new_content" ]; then
        continue
    fi

    if [ "$old_version" = "$new_version" ]; then
        echo "ERROR: $file has unchanged @version ($old_version). Please bump the version."
        failed=1
    fi
done

exit $failed
